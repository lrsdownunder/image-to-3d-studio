# Copy to .env on the GPU machine and fill in. NEVER commit the real file.
GENERATION_BACKEND_TOKEN=change-me-long-random-password-1
GENERATION_CALLBACK_SECRET=change-me-long-random-password-2
# Hugging Face read token (needed for the gated DINOv3 image model)
HF_TOKEN=hf_xxx
# Your site + storage hosts, comma separated (see README step 9)
ALLOWED_HOSTS=lovable.app,supabase.co
TRELLIS_PIPELINE_TYPE=1024_cascade
TEXTURE_MODE=vertex
TRELLIS_MODEL_DIR=/workspace/models/TRELLIS.2-4B
